# Copiá este archivo como ".env" (sin .example) y completalo.

# Dirección del servidor de SON (el del dominio, con https)
SON_URL=https://son.tudominio.com

# Clave compartida con el servidor: tiene que ser EXACTAMENTE la misma que AGENTE_TOKEN del servidor.
# Usá una larga y al azar (mínimo 24 caracteres).
AGENTE_TOKEN=

# Carpeta con una subcarpeta por cliente
CARPETA_CLIENTES=\\sa-server\HIGIENE Y SEGURIDAD\00. CLIENTES

# Cada cuántos milisegundos revisa si hay informes nuevos (opcional, por defecto 30000)
# AGENTE_CADA_MS=30000
