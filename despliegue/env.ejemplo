# Configuración del servidor. Lo normal es generarlo con:  .\generar-env.ps1
# (crea claves al azar). Este archivo es solo de ejemplo.
DOMINIO=son.tudominio.com
DB_PASSWORD=una-clave-larga-al-azar
JWT_SECRET=otra-clave-larga-al-azar
# Administrador inicial: solo se crea si la base está vacía.
ADMIN_EMAIL=tu@correo.com
ADMIN_PASSWORD=una-clave-que-vas-a-cambiar
ADMIN_NOMBRE=Tu Nombre
# Dirección de la base vacía (el botón «Solicitar una demostración»).
# En Cloudflare: un registro A con el nombre demo y la misma IP del servidor. Nube gris.
DEMO_DOMINIO=demo.sonoperation.com
DEMO_JWT_SECRET=otra-clave-larga-distinta
DEMO_ADMIN_EMAIL=demo@sonoperation.com
DEMO_ADMIN_PASSWORD=conocer-son
DEMO_ADMIN_NOMBRE=Demostración
